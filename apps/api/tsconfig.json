{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "outDir": "dist",
        "rootDir": "src",
        "types": [
            "node"
        ],
        "noEmit": false
    },
    "include": [
        "src/**/*.ts",
        "api/[...path].ts"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}