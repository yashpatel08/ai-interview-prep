{
    "version": 2,
    "buildCommand": "cd ../.. && npm run build:api",
    "installCommand": "cd ../.. && npm install",
    "functions": {
        "dist/index.js": {
            "includeFiles": "dist/**"
        }
    },
    "rewrites": [
        { "source": "/(.*)", "destination": "/dist/index.js" }
    ]
}